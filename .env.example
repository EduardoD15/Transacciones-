SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
TRANSACTION_SECRET=pon-aqui-una-clave-larga-aleatoria
# Cantidad de transacciones consecutivas del mismo usuario que se evalúan.
# Se marca anomalía si esa ventana completa ocurre en 3 segundos o menos.
# `date` se interpreta como hora de Colombia (America/Bogota).
# Acepta timestamps sin zona (interpretados como Colombia) o con sufijo -05:00.
# Según la hora de Colombia incluida en `date`: mañana 05:00:01-12:00:00,
# tarde-noche 12:00:01-20:00:00 y noche-madrugada 20:00:01-05:00:00.
WINDOW_MORNING_TRANSACTIONS=10
WINDOW_AFTERNOON_TRANSACTIONS=6
WINDOW_NIGHT_TRANSACTIONS=3

# Solo para mostrar cantidades en el dashboard; deben coincidir con las de arriba.
NEXT_PUBLIC_WINDOW_MORNING_TRANSACTIONS=10
NEXT_PUBLIC_WINDOW_AFTERNOON_TRANSACTIONS=6
NEXT_PUBLIC_WINDOW_NIGHT_TRANSACTIONS=3
